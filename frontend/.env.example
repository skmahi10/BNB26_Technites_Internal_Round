# FastAPI base URL. Leave blank only when the deployment uses a same-origin reverse proxy.
NEXT_PUBLIC_API_BASE_URL=

# Set each path to the matching endpoint documented by the backend API contract.
# Paths are intentionally blank; this frontend does not invent backend routes.
NEXT_PUBLIC_API_DASHBOARD_PATH=
NEXT_PUBLIC_API_MODELS_PATH=
NEXT_PUBLIC_API_MODEL_DETAIL_PATH=
NEXT_PUBLIC_API_ARTIFACTS_PATH=
NEXT_PUBLIC_API_ARTIFACT_DETAIL_PATH=
NEXT_PUBLIC_API_VERIFICATIONS_PATH=
NEXT_PUBLIC_API_PROVENANCE_PATH=
NEXT_PUBLIC_API_TESTING_PATH=
NEXT_PUBLIC_API_LIFECYCLE_PATH=
NEXT_PUBLIC_API_HISTORY_PATH=
NEXT_PUBLIC_API_ACTIVITY_PATH=
